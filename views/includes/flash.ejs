<% if (success && success.length) { %>
  <div class="alert alert-success alert-dismissible fade show col-12 col-md-8 offset-md-2 rounded-4 shadow-sm my-3 d-flex align-items-center gap-2" role="alert">
    <i class="fa-solid fa-circle-check fs-5"></i>
    <div class="fw-semibold"><%= success %></div>
    <button type="button" class="btn-close shadow-none" data-bs-dismiss="alert" aria-label="Close"></button>
  </div>
<% } %>

<% if (error && error.length) { %>
  <div class="alert alert-danger alert-dismissible fade show col-12 col-md-8 offset-md-2 rounded-4 shadow-sm my-3 d-flex align-items-center gap-2" role="alert">
    <i class="fa-solid fa-circle-exclamation fs-5"></i>
    <div class="fw-semibold"><%= error %></div>
    <button type="button" class="btn-close shadow-none" data-bs-dismiss="alert" aria-label="Close"></button>
  </div>
<% } %>