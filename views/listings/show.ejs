<% layout('layouts/boilerplate') %>

<div class="show-page-wrapper py-4">
  <!-- Page Header: Title, Rating, Location, Action Buttons -->
  <div class="mb-3">
    <h2 class="fw-bold mb-1 text-dark"><%= listing.title %></h2>
    <div class="d-flex align-items-center justify-content-between flex-wrap gap-2 text-muted small">
      <div class="d-flex align-items-center gap-3">
        <span class="d-flex align-items-center gap-1 text-dark fw-semibold">
          <i class="fa-solid fa-star text-warning"></i>
          <span>4.88</span>
        </span>
        <span>·</span>
        <a href="#reviews-section" class="text-dark fw-semibold text-decoration-underline">
          <%= listing.reviews ? listing.reviews.length : 0 %> reviews
        </a>
        <span>·</span>
        <span class="d-flex align-items-center gap-1">
          <i class="fa-solid fa-medal text-danger"></i>
          <span class="fw-semibold text-dark">Superhost</span>
        </span>
        <span>·</span>
        <a href="#map-section" class="text-muted text-decoration-underline">
          <%= listing.location %>, <%= listing.country %>
        </a>
      </div>

      <div class="d-flex align-items-center gap-3">
        <button class="btn btn-sm btn-light border-0 d-flex align-items-center gap-2 fw-semibold text-dark px-3 py-1 rounded-pill" onclick="navigator.clipboard.writeText(window.location.href); alert('Link copied to clipboard!');">
          <i class="fa-solid fa-arrow-up-from-bracket"></i> Share
        </button>
        <button class="btn btn-sm btn-light border-0 d-flex align-items-center gap-2 fw-semibold text-dark px-3 py-1 rounded-pill" id="detail-wishlist-btn">
          <i class="fa-regular fa-heart"></i> Save
        </button>
      </div>
    </div>
  </div>

  <!-- Hero Photo -->
  <div class="show-hero-container mb-4 shadow-sm position-relative">
    <img src="<%= listing.image.url %>" class="show-hero-img" alt="<%= listing.title %>">
    <% if (listing.category) { %>
      <span class="category-badge position-absolute bottom-0 start-0 m-3 px-3 py-2 rounded-pill small fw-semibold text-white shadow">
        <i class="fa-solid fa-tag me-1"></i> <%= listing.category %>
      </span>
    <% } %>
  </div>

  <!-- Main 2-Column Section -->
  <div class="row g-5">
    <!-- Left Column: Details, Host, Amenities, Reviews, Map -->
    <div class="col-lg-7">
      <!-- Host Header Card -->
      <div class="d-flex align-items-center justify-content-between pb-4 border-bottom">
        <div>
          <h4 class="fw-bold mb-1 text-dark">
            Entire stay hosted by <%= listing.owner ? listing.owner.username : 'Superhost' %>
          </h4>
          <p class="text-muted small mb-0">
            4 guests · 2 bedrooms · 2 beds · 2 private baths
          </p>
        </div>
        <div class="user-avatar-circle" style="width: 54px; height: 54px; font-size: 1.4rem;">
          <%= listing.owner ? listing.owner.username.charAt(0).toUpperCase() : 'H' %>
        </div>
      </div>

      <!-- Key Hospitality Highlights -->
      <div class="py-4 border-bottom">
        <div class="d-flex align-items-start gap-3 mb-3">
          <i class="fa-solid fa-door-open fs-4 text-dark mt-1"></i>
          <div>
            <div class="fw-bold text-dark">Self check-in</div>
            <div class="text-muted small">Check yourself in with the smart keypad lock.</div>
          </div>
        </div>
        <div class="d-flex align-items-start gap-3 mb-3">
          <i class="fa-solid fa-location-dot fs-4 text-dark mt-1"></i>
          <div>
            <div class="fw-bold text-dark">Great location</div>
            <div class="text-muted small">95% of recent guests gave the location a 5-star rating.</div>
          </div>
        </div>
        <div class="d-flex align-items-start gap-3">
          <i class="fa-solid fa-calendar-check fs-4 text-dark mt-1"></i>
          <div>
            <div class="fw-bold text-dark">Free cancellation before 48 hours</div>
            <div class="text-muted small">Get a full refund if your plans change.</div>
          </div>
        </div>
      </div>

      <!-- Description -->
      <div class="py-4 border-bottom">
        <h5 class="fw-bold mb-3 text-dark">About this space</h5>
        <p class="text-dark" style="line-height: 1.7; font-size: 0.98rem;">
          <%= listing.description %>
        </p>
      </div>

      <!-- Amenities Section -->
      <div class="py-4 border-bottom">
        <h5 class="fw-bold mb-3 text-dark">What this place offers</h5>
        <div class="row row-cols-1 row-cols-sm-2 g-2">
          <div class="col">
            <div class="amenity-item">
              <i class="fa-solid fa-wifi"></i>
              <span>Fast continuous Wi-Fi (150 Mbps)</span>
            </div>
          </div>
          <div class="col">
            <div class="amenity-item">
              <i class="fa-solid fa-laptop"></i>
              <span>Dedicated workspace</span>
            </div>
          </div>
          <div class="col">
            <div class="amenity-item">
              <i class="fa-solid fa-kitchen-set"></i>
              <span>Fully equipped kitchen</span>
            </div>
          </div>
          <div class="col">
            <div class="amenity-item">
              <i class="fa-solid fa-square-parking"></i>
              <span>Free parking on premises</span>
            </div>
          </div>
          <div class="col">
            <div class="amenity-item">
              <i class="fa-solid fa-snowflake"></i>
              <span>Central air conditioning</span>
            </div>
          </div>
          <div class="col">
            <div class="amenity-item">
              <i class="fa-solid fa-tv"></i>
              <span>55" 4K Smart TV with Netflix</span>
            </div>
          </div>
          <div class="col">
            <div class="amenity-item">
              <i class="fa-solid fa-water-ladder"></i>
              <span>Private patio / outdoor space</span>
            </div>
          </div>
          <div class="col">
            <div class="amenity-item">
              <i class="fa-solid fa-shield-halved"></i>
              <span>Smoke alarm & first aid kit</span>
            </div>
          </div>
        </div>
      </div>

      <!-- Host Action Controls (if owner) -->
      <% if (currUser && listing.owner && currUser._id.equals(listing.owner._id)) { %>
        <div class="py-3 border-bottom d-flex align-items-center gap-3">
          <span class="small fw-semibold text-muted">Host Actions:</span>
          <a href="/listing/<%= listing._id %>/edit" class="btn btn-outline-dark btn-sm rounded-pill px-3">
            <i class="fa-solid fa-pen-to-square me-1"></i> Edit listing
          </a>
          <form method="post" action="/listing/<%= listing._id %>?_method=DELETE" class="m-0" onsubmit="return confirm('Are you sure you want to delete this listing?');">
            <button class="btn btn-outline-danger btn-sm rounded-pill px-3">
              <i class="fa-solid fa-trash me-1"></i> Delete
            </button>
          </form>
        </div>
      <% } %>

      <!-- Reviews Section -->
      <div class="py-4 border-bottom" id="reviews-section">
        <div class="d-flex align-items-center gap-2 mb-3">
          <i class="fa-solid fa-star text-warning fs-5"></i>
          <h4 class="fw-bold mb-0 text-dark">4.88 · <%= listing.reviews ? listing.reviews.length : 0 %> reviews</h4>
        </div>

        <!-- Rating Metrics Breakdown -->
        <div class="row row-cols-1 row-cols-sm-2 g-3 mb-4">
          <div class="col d-flex align-items-center justify-content-between gap-3">
            <span class="small text-muted">Cleanliness</span>
            <div class="d-flex align-items-center gap-2 w-50">
              <div class="rating-bar-track"><div class="rating-bar-fill" style="width: 98%;"></div></div>
              <span class="small fw-bold">4.9</span>
            </div>
          </div>
          <div class="col d-flex align-items-center justify-content-between gap-3">
            <span class="small text-muted">Accuracy</span>
            <div class="d-flex align-items-center gap-2 w-50">
              <div class="rating-bar-track"><div class="rating-bar-fill" style="width: 96%;"></div></div>
              <span class="small fw-bold">4.8</span>
            </div>
          </div>
          <div class="col d-flex align-items-center justify-content-between gap-3">
            <span class="small text-muted">Communication</span>
            <div class="d-flex align-items-center gap-2 w-50">
              <div class="rating-bar-track"><div class="rating-bar-fill" style="width: 100%;"></div></div>
              <span class="small fw-bold">5.0</span>
            </div>
          </div>
          <div class="col d-flex align-items-center justify-content-between gap-3">
            <span class="small text-muted">Location</span>
            <div class="d-flex align-items-center gap-2 w-50">
              <div class="rating-bar-track"><div class="rating-bar-fill" style="width: 98%;"></div></div>
              <span class="small fw-bold">4.9</span>
            </div>
          </div>
        </div>

        <!-- Existing Reviews Cards -->
        <% if (listing.reviews && listing.reviews.length > 0) { %>
          <div class="row row-cols-1 row-cols-md-2 g-3 mb-4">
            <% for (let review of listing.reviews) { %>
              <div class="col">
                <div class="card h-100 border rounded-4 p-3 shadow-none bg-light">
                  <div class="d-flex align-items-center justify-content-between mb-2">
                    <div class="d-flex align-items-center gap-2">
                      <div class="user-avatar-circle" style="width: 34px; height: 34px; font-size: 0.85rem;">
                        <%= review.author ? review.author.username.charAt(0).toUpperCase() : 'G' %>
                      </div>
                      <div>
                        <div class="fw-bold small text-dark">@<%= review.author ? review.author.username : 'guest' %></div>
                        <div class="text-muted" style="font-size: 0.75rem;">Verified Traveler</div>
                      </div>
                    </div>
                    <div class="text-warning small">
                      <% for (let i = 0; i < (review.rating || 5); i++) { %>
                        <i class="fa-solid fa-star"></i>
                      <% } %>
                    </div>
                  </div>
                  <p class="card-text text-dark small mb-2"><%= review.comment %></p>

                  <% if (currUser && review.author && currUser._id.equals(review.author._id)) { %>
                    <form method="post" action="/listing/<%= listing._id %>/reviews/<%= review._id %>?_method=DELETE" class="mt-auto">
                      <button class="btn btn-sm btn-link text-danger p-0 text-decoration-none small">
                        <i class="fa-solid fa-trash me-1"></i> Delete review
                      </button>
                    </form>
                  <% } %>
                </div>
              </div>
            <% } %>
          </div>
        <% } %>

        <!-- Leave a Review Form -->
        <% if (currUser) { %>
          <div class="bg-white border rounded-4 p-4 mt-3">
            <h5 class="fw-bold mb-3 text-dark">Leave a review</h5>
            <form method="post" action="/listing/<%= listing._id %>/reviews" novalidate class="needs-validation">
              <div class="mb-3">
                <label for="rating" class="form-label small fw-semibold text-muted">Rating</label>
                <fieldset class="starability-slot">
                  <input type="radio" id="no-rate" class="input-no-rate" name="review[rating]" value="1" checked aria-label="No rating." />
                  <input type="radio" id="first-rate1" name="review[rating]" value="1" />
                  <label for="first-rate1" title="Terrible">1 star</label>
                  <input type="radio" id="first-rate2" name="review[rating]" value="2" />
                  <label for="first-rate2" title="Not good">2 stars</label>
                  <input type="radio" id="first-rate3" name="review[rating]" value="3" />
                  <label for="first-rate3" title="Average">3 stars</label>
                  <input type="radio" id="first-rate4" name="review[rating]" value="4" />
                  <label for="first-rate4" title="Very good">4 stars</label>
                  <input type="radio" id="first-rate5" name="review[rating]" value="5" />
                  <label for="first-rate5" title="Amazing">5 stars</label>
                </fieldset>
              </div>

              <div class="mb-3">
                <label for="comment" class="form-label small fw-semibold text-muted">Your experience</label>
                <textarea name="review[comment]" id="comment" cols="30" rows="3" class="form-control rounded-3" placeholder="What did you love about staying here?" required></textarea>
                <div class="invalid-feedback">Please share a few words about your stay.</div>
              </div>

              <button class="btn btn-dark rounded-pill px-4 py-2 fw-semibold">
                Submit review
              </button>
            </form>
          </div>
        <% } %>
      </div>

      <!-- Map Section -->
      <div class="py-4" id="map-section">
        <h5 class="fw-bold mb-1 text-dark">Where you'll be</h5>
        <p class="text-muted small mb-3">
          <i class="fa-solid fa-location-dot me-1 text-danger"></i>
          <%= listing.location %>, <%= listing.country %>
        </p>
        <div id="map" class="shadow-sm"></div>
      </div>
    </div>

    <!-- Right Column: Sticky Reservation Booking Widget -->
    <div class="col-lg-5">
      <div class="sticky-booking-widget">
        <div class="d-flex align-items-baseline justify-content-between mb-3">
          <div>
            <span class="fs-4 fw-bold text-dark">&#8377;<%= Number(listing.price).toLocaleString("en-IN") %></span>
            <span class="text-muted small"> / night</span>
          </div>
          <div class="d-flex align-items-center gap-1 small fw-semibold">
            <i class="fa-solid fa-star text-warning"></i>
            <span>4.88</span>
            <span class="text-muted">· <%= listing.reviews ? listing.reviews.length : 0 %> reviews</span>
          </div>
        </div>

        <!-- Date & Guest Input Box -->
        <div class="date-picker-box mb-3">
          <div class="row g-0">
            <div class="col-6 date-input-col border-end">
              <label class="small text-uppercase text-muted fw-bold d-block" style="font-size: 0.65rem;">Check-in</label>
              <input type="date" id="checkin-date" class="form-control form-control-sm border-0 p-0 shadow-none fw-semibold">
            </div>
            <div class="col-6 date-input-col">
              <label class="small text-uppercase text-muted fw-bold d-block" style="font-size: 0.65rem;">Checkout</label>
              <input type="date" id="checkout-date" class="form-control form-control-sm border-0 p-0 shadow-none fw-semibold">
            </div>
          </div>
          <div class="guest-input-row">
            <label class="small text-uppercase text-muted fw-bold d-block" style="font-size: 0.65rem;">Guests</label>
            <select id="guests-select" class="form-select form-select-sm border-0 p-0 shadow-none fw-semibold">
              <option value="1">1 guest</option>
              <option value="2" selected>2 guests</option>
              <option value="3">3 guests</option>
              <option value="4">4 guests</option>
            </select>
          </div>
        </div>

        <!-- Reserve CTA Button -->
        <button type="button" class="btn btn-reserve-gradient w-100 shadow-sm mb-3" id="reserve-btn">
          Reserve
        </button>
        <p class="text-center text-muted small mb-3">You won't be charged yet</p>

        <!-- Dynamic Price Breakdown Calculation -->
        <div class="price-breakdown-box">
          <div class="d-flex justify-content-between text-muted small py-1">
            <span id="price-calc-label">&#8377;<%= Number(listing.price).toLocaleString("en-IN") %> × 3 nights</span>
            <span class="text-dark fw-semibold" id="price-calc-subtotal">&#8377;<%= (Number(listing.price) * 3).toLocaleString("en-IN") %></span>
          </div>
          <div class="d-flex justify-content-between text-muted small py-1">
            <span>Cleaning fee</span>
            <span class="text-dark fw-semibold">&#8377;500</span>
          </div>
          <div class="d-flex justify-content-between text-muted small py-1">
            <span>Airbnb service fee</span>
            <span class="text-dark fw-semibold">&#8377;800</span>
          </div>
          <div class="d-flex justify-content-between text-muted small py-1">
            <span>Taxes (18% GST)</span>
            <span class="text-dark fw-semibold" id="price-calc-tax">&#8377;<%= Math.round((Number(listing.price) * 3 + 1300) * 0.18).toLocaleString("en-IN") %></span>
          </div>
          <hr class="my-2">
          <div class="d-flex justify-content-between fw-bold text-dark fs-6 pt-1">
            <span>Total before taxes</span>
            <span id="price-calc-total">&#8377;<%= Math.round((Number(listing.price) * 3 + 1300) * 1.18).toLocaleString("en-IN") %></span>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<!-- Reservation Confirmation Modal -->
<div class="modal fade" id="reservationModal" tabindex="-1" aria-labelledby="reservationModalLabel" aria-hidden="true">
  <div class="modal-dialog modal-dialog-centered">
    <div class="modal-content rounded-4 border-0 shadow">
      <div class="modal-header border-0 pb-0">
        <button type="button" class="btn-close shadow-none" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>
      <div class="modal-body text-center p-4 pt-0">
        <div class="mb-3 text-success">
          <i class="fa-solid fa-circle-check fa-4x"></i>
        </div>
        <h4 class="fw-bold text-dark mb-1">Reservation Confirmed!</h4>
        <p class="text-muted small mb-3">
          Your stay at <strong><%= listing.title %></strong> has been requested. We sent your itinerary to your email.
        </p>
        <div class="bg-light p-3 rounded-3 text-start small mb-3">
          <div class="d-flex justify-content-between mb-1">
            <span class="text-muted">Host:</span>
            <span class="fw-semibold"><%= listing.owner ? listing.owner.username : 'Superhost' %></span>
          </div>
          <div class="d-flex justify-content-between mb-1">
            <span class="text-muted">Location:</span>
            <span class="fw-semibold"><%= listing.location %>, <%= listing.country %></span>
          </div>
          <div class="d-flex justify-content-between">
            <span class="text-muted">Estimated Total:</span>
            <span class="fw-bold text-dark" id="modal-confirmed-total"></span>
          </div>
        </div>
        <button type="button" class="btn btn-dark w-100 rounded-pill py-2 fw-semibold" data-bs-dismiss="modal">
          Done
        </button>
      </div>
    </div>
  </div>
</div>

<script>
  const listing = <%- JSON.stringify(listing) %>;

  document.addEventListener("DOMContentLoaded", () => {
    // 1. Setup Default Dates
    const checkin = document.getElementById("checkin-date");
    const checkout = document.getElementById("checkout-date");
    const basePrice = Number(listing.price) || 1000;

    const today = new Date();
    const checkinDate = new Date();
    checkinDate.setDate(today.getDate() + 3);
    const checkoutDate = new Date();
    checkoutDate.setDate(today.getDate() + 6);

    if (checkin && checkout) {
      checkin.value = checkinDate.toISOString().split("T")[0];
      checkout.value = checkoutDate.toISOString().split("T")[0];

      checkin.addEventListener("change", recalculatePrice);
      checkout.addEventListener("change", recalculatePrice);
    }

    function recalculatePrice() {
      const d1 = new Date(checkin.value);
      const d2 = new Date(checkout.value);
      let nights = Math.round((d2 - d1) / (1000 * 60 * 60 * 24));
      if (isNaN(nights) || nights < 1) nights = 1;

      const stayCost = basePrice * nights;
      const cleaningFee = 500;
      const serviceFee = 800;
      const tax = Math.round((stayCost + cleaningFee + serviceFee) * 0.18);
      const total = stayCost + cleaningFee + serviceFee + tax;

      document.getElementById("price-calc-label").textContent = `₹${basePrice.toLocaleString("en-IN")} × ${nights} night${nights > 1 ? 's' : ''}`;
      document.getElementById("price-calc-subtotal").textContent = `₹${stayCost.toLocaleString("en-IN")}`;
      document.getElementById("price-calc-tax").textContent = `₹${tax.toLocaleString("en-IN")}`;
      document.getElementById("price-calc-total").textContent = `₹${total.toLocaleString("en-IN")}`;
      document.getElementById("modal-confirmed-total").textContent = `₹${total.toLocaleString("en-IN")}`;
    }

    recalculatePrice();

    // 2. Reserve Modal Trigger
    const reserveBtn = document.getElementById("reserve-btn");
    if (reserveBtn) {
      reserveBtn.addEventListener("click", () => {
        const modal = new bootstrap.Modal(document.getElementById("reservationModal"));
        modal.show();
      });
    }

    // 3. Wishlist Save Button in Detail Page
    const detailWishlistBtn = document.getElementById("detail-wishlist-btn");
    if (detailWishlistBtn) {
      const saved = JSON.parse(localStorage.getItem("wanderlust_wishlist") || "[]");
      const icon = detailWishlistBtn.querySelector("i");
      if (saved.includes(listing._id)) {
        icon.classList.remove("fa-regular");
        icon.classList.add("fa-solid", "text-danger");
        detailWishlistBtn.querySelector("span, text") || (detailWishlistBtn.lastChild.textContent = " Saved");
      }

      detailWishlistBtn.addEventListener("click", () => {
        const curList = JSON.parse(localStorage.getItem("wanderlust_wishlist") || "[]");
        const idx = curList.indexOf(listing._id);
        if (idx === -1) {
          curList.push(listing._id);
          icon.classList.remove("fa-regular");
          icon.classList.add("fa-solid", "text-danger");
          detailWishlistBtn.lastChild.textContent = " Saved";
        } else {
          curList.splice(idx, 1);
          icon.classList.remove("fa-solid", "text-danger");
          icon.classList.add("fa-regular");
          detailWishlistBtn.lastChild.textContent = " Save";
        }
        localStorage.setItem("wanderlust_wishlist", JSON.stringify(curList));
      });
    }
  });
</script>
<script src="/js/map.js"></script>




