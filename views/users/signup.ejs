<% layout('layouts/boilerplate') %>

<div class="row justify-content-center my-5">
  <div class="col-12 col-sm-9 col-md-6 col-lg-5 col-xl-4">
    <div class="card border rounded-4 shadow-sm p-4 p-md-4">
      <div class="text-center mb-4">
        <div class="brand-icon mb-2">
          <i class="fa-regular fa-compass fa-2x" style="color: var(--primary-color);"></i>
        </div>
        <h4 class="fw-bold text-dark mb-1">Create an account</h4>
        <p class="text-muted small">Join Wanderlust to explore and book stays</p>
      </div>

      <form method="post" action="/signup" novalidate class="needs-validation">
        <div class="mb-3">
          <label for="username" class="form-label small fw-semibold text-muted">Username</label>
          <input type="text" id="username" name="username" class="form-control rounded-3 py-2" placeholder="Choose a username" required>
          <div class="invalid-feedback">Please choose a username.</div>
        </div>

        <div class="mb-3">
          <label for="email" class="form-label small fw-semibold text-muted">Email address</label>
          <input type="email" id="email" name="email" class="form-control rounded-3 py-2" placeholder="name@example.com" required>
          <div class="invalid-feedback">Please enter a valid email.</div>
        </div>

        <div class="mb-4">
          <label for="password" class="form-label small fw-semibold text-muted">Password</label>
          <input type="password" id="password" name="password" class="form-control rounded-3 py-2" placeholder="Create a strong password" required minlength="6">
          <div class="invalid-feedback">Password must be at least 6 characters.</div>
        </div>

        <button class="btn btn-reserve-gradient w-100 rounded-pill py-2 fw-semibold mb-3">
          Create account
        </button>

        <div class="text-center small text-muted">
          Already have an account? 
          <a href="/login" class="fw-bold text-dark text-decoration-none">Log in</a>
        </div>
      </form>
    </div>
  </div>
</div>